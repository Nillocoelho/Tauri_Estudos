{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Acesso local da janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-select",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
